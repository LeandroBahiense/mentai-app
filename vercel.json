{
  "redirects": [
    { "source": "/landing.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/:path*", "destination": "/app.html" },
    { "source": "/partnerdesign", "destination": "/partnerdesign.html" },
    { "source": "/privacidade", "destination": "/privacidade.html" },
    { "source": "/sub-processadores", "destination": "/sub-processadores.html" },
    { "source": "/termos", "destination": "/termos.html" }
  ],
  "crons": [
    { "path": "/api/cron/briefing", "schedule": "0 * * * *" },
    { "path": "/api/cron/daily-usage", "schedule": "59 23 * * *" },
    { "path": "/api/cron/index-notes", "schedule": "0 3 * * *" },
    { "path": "/api/cron/plan-expiry-email", "schedule": "0 13 * * *" }
  ]
}
