{
  "redirects": [
    { "source": "/", "destination": "/landing.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/:path*", "destination": "/index.html" },
    { "source": "/privacidade", "destination": "/privacidade.html" },
    { "source": "/termos", "destination": "/termos.html" }
  ],
  "crons": [
    { "path": "/api/cron/briefing", "schedule": "0 11 * * *" },
    { "path": "/api/cron/daily-usage", "schedule": "59 23 * * *" }
  ]
}
